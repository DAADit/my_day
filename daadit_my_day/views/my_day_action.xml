<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_my_day_working_hours" model="ir.ui.view">
        <field name="name">hr.employee.form.my.day.working.hours</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Working Hours" create="0" duplicate="0" delete="0">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="resource_calendar_id"
                           domain="[('company_id', 'in', [False, company_id])]"
                           options="{'no_create': True}"/>
                </group>
                <p class="text-muted">Choose your working schedule. Changes to a shared schedule affect everyone who uses it.</p>
            </form>
        </field>
    </record>

    <record id="action_my_day" model="ir.actions.client">
        <field name="name">My Day</field>
        <field name="tag">daadit_my_day.main</field>
        <field name="target">current</field>
    </record>
    <record id="action_my_day_priorities" model="ir.actions.client">
        <field name="name">Priorities</field>
        <field name="tag">daadit_my_day.main</field>
        <field name="target">current</field>
        <field name="params" eval="{'view': 'priorities'}"/>
    </record>
    <record id="action_my_day_done" model="ir.actions.client">
        <field name="name">Completed</field>
        <field name="tag">daadit_my_day.main</field>
        <field name="target">current</field>
        <field name="params" eval="{'view': 'done'}"/>
    </record>
    <record id="action_my_day_review" model="ir.actions.client">
        <field name="name">Close day</field>
        <field name="tag">daadit_my_day.main</field>
        <field name="target">current</field>
        <field name="params" eval="{'view': 'day'}"/>
    </record>

    <menuitem id="menu_my_day_root"
              name="My Day"
              action="action_my_day"
              web_icon="daadit_my_day,static/description/icon.png"
              groups="base.group_user"
              sequence="1"/>
    <menuitem id="menu_my_day_today" name="Today" parent="menu_my_day_root"
              action="action_my_day" sequence="10"/>
    <menuitem id="menu_my_day_priorities" name="Priorities" parent="menu_my_day_root"
              action="action_my_day_priorities" sequence="20"/>
    <menuitem id="menu_my_day_wrap_up" name="Wrap-up" parent="menu_my_day_root"
              sequence="40"/>
    <menuitem id="menu_my_day_review" name="Close day" parent="menu_my_day_wrap_up"
              action="action_my_day_review" sequence="10"/>
    <menuitem id="menu_my_day_done" name="Completed" parent="menu_my_day_wrap_up"
              action="action_my_day_done" sequence="20"/>
</odoo>
