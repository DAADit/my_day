<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_plan_days" model="ir.cron">
        <field name="name">My Day: reschedule working days</field>
        <field name="model_id" ref="model_daadit_my_day"/>
        <field name="state">code</field>
        <field name="code">model._cron_plan_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:30:00')"/>
    </record>
    <record id="cron_fill_days" model="ir.cron">
        <field name="name">My Day: schedule new work and update timers</field>
        <field name="model_id" ref="model_daadit_my_day"/>
        <field name="state">code</field>
        <field name="code">model._cron_fill_all()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
