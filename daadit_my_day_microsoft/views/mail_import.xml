<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_own_mail_work" model="ir.rule">
        <field name="name">Own Microsoft 365 messages</field>
        <field name="model_id" ref="model_daadit_my_day_mail_work"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="view_my_day_mail_import" model="ir.ui.view">
        <field name="name">daadit.my.day.mail.import.form</field>
        <field name="model">daadit.my.day.mail.import</field>
        <field name="arch" type="xml">
            <form string="Microsoft 365 mail">
                <header>
                    <button name="action_connect" type="object" string="Connect Microsoft 365"/>
                    <button name="action_refresh" type="object" string="Load inbox" class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name" string="Subject"/>
                            <field name="sender" string="Sender"/>
                            <field name="received" string="Received"/>
                            <field name="preview" string="Preview"/>
                        </list>
                    </field>
                    <group invisible="not line_ids">
                        <field name="message_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="ticket_id" options="{'no_create': True}"/>
                        <field name="task_id" options="{'no_create': True}"/>
                    </group>
                    <button name="action_link" type="object" class="btn-primary" string="Add to My Day"
                            invisible="not message_id"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_import_mail" model="ir.actions.act_window">
        <field name="name">Microsoft 365 mail</field>
        <field name="res_model">daadit.my.day.mail.import</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <record id="view_my_day_mail_work_list" model="ir.ui.view">
        <field name="name">daadit.my.day.mail.work.list</field>
        <field name="model">daadit.my.day.mail.work</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="subject"/>
                <field name="task_id"/>
                <field name="ticket_id"/>
            </list>
        </field>
    </record>
    <record id="view_my_day_mail_work_form" model="ir.ui.view">
        <field name="name">daadit.my.day.mail.work.form</field>
        <field name="model">daadit.my.day.mail.work</field>
        <field name="arch" type="xml">
            <form string="Selected mail" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="subject" readonly="1"/>
                        <field name="ticket_id" readonly="1" invisible="not ticket_id"/>
                        <field name="task_id" readonly="1" invisible="not task_id"/>
                        <field name="body" string="Received message" readonly="1"/>
                        <field name="draft" string="Private reply draft"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_selected_mail" model="ir.actions.act_window">
        <field name="name">Selected mail</field>
        <field name="res_model">daadit.my.day.mail.work</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Retire the old shortcut on existing databases. The base app owns Vandaag. -->
    <record id="menu_schedule" model="ir.ui.menu">
        <field name="name">My Day</field>
        <field name="active" eval="False"/>
    </record>
    <menuitem id="menu_mail" name="Mail" parent="daadit_my_day.menu_my_day_root"
              sequence="30" groups="base.group_user"/>
    <menuitem id="menu_import_mail" name="Inbox" parent="menu_mail" action="action_import_mail"
              sequence="10" groups="base.group_user"/>
    <menuitem id="menu_selected_mail" name="Selected mail" parent="menu_mail" action="action_selected_mail"
              sequence="20" groups="base.group_user"/>
</odoo>
